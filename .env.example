# Application Settings
APP_NAME="Telegram AI Vape Store"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
SECRET_KEY=super-secret-key-change-in-production-vape-store-2026

# Telegram Bot
# მიიღეთ @BotFather-ისგან
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ტელეგრამ ჩანელის ID ან Username (მაგ: @your_vape_channel ან -100xxxxxxxxxx)
TELEGRAM_CHANNEL_ID=@your_channel_username

# ადმინის Telegram ID (რომელზეც მოვა შეკვეთის შეტყობინებები). გაიგეთ @userinfobot-ისგან
# რამდენიმე ID-ის შემთხვევაში გამოყავით მძიმით: "12345678,87654321"
ADMIN_TELEGRAM_IDS=12345678

# Google Gemini API
# მიიღეთ Google AI Studio-დან ან Google Cloud Console-დან
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Database (SQLite default)
DATABASE_URL=sqlite+aiosqlite:///store.db

# Email Alerts (SMTP - სურვილისამებრ)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=
